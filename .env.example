# ─────────────────────────────────────────────
#  CONFIGURATION SERVEUR POS
# ─────────────────────────────────────────────

# Base de données SQLite (ne pas modifier)
DATABASE_URL="file:./dev.db"

# Port du serveur Express (défaut: 5000)
PORT=5000

# ═══════════════════════════════════════════════════════════════
#  🖨️  CONFIGURATION IMPRIMANTE THERMIQUE 80mm
# ═══════════════════════════════════════════════════════════════
#
#  ┌─ Cas 1 — IMPRIMANTE RÉSEAU (connectée au modem/routeur Wi-Fi)
#  │   Compatible Windows et Linux
#  │   Décommentez et renseignez l'IP de l'imprimante.
#  │   (Trouvez l'IP depuis le menu de l'imprimante ou votre box)
#  │
#  │   Sur Windows : l'imprimante est auto-installée dans le spooler
#  │   au premier lancement. Pas besoin de rien faire manuellement.
#  │
# PRINTER_IP=192.168.1.150
# PRINTER_PORT=631
#
#  ├─ Cas 2 — IMPRIMANTE USB sous Windows
#  │   Renseignez le nom EXACT de l'imprimante affiché dans
#  │   "Panneau de configuration > Périphériques et imprimantes"
#  │
# PRINTER_NAME=Xprinter XP-80
#
#  └─ Cas 3 — IMPRIMANTE USB sous Linux
#     Renseignez le nom de la file CUPS de l'imprimante.
#     (Trouvez le nom avec la commande : lpstat -a)
#
# PRINTER_NAME=Xprinter-80mm
#
# ═══════════════════════════════════════════════════════════════
#  RÉSUMÉ : une seule ligne à décommenter selon votre situation
# ═══════════════════════════════════════════════════════════════
#
#  Imprimante réseau (Wi-Fi/Ethernet) → PRINTER_IP=192.168.1.XXX
#  Imprimante USB Windows             → PRINTER_NAME=Nom Windows
#  Imprimante USB Linux               → PRINTER_NAME=nom-cups
#  Imprimante par défaut (rien)       → laisser tout commenté
#
# ═══════════════════════════════════════════════════════════════
#  🔌 CONFIGURATION ESC/POS DIRECTE (Bypass du Spooler PDF OS)
# ═══════════════════════════════════════════════════════════════
#  PRINTER_CONNECTION : Connexion directe ('usb', 'network', ou 'pdf' par défaut)
#  PRINTER_CONNECTION=pdf
#
#  Pour PRINTER_CONNECTION=usb (Vendor ID & Product ID en héxadécimal ou décimal)
#  PRINTER_USB_VID=0x04b8
#  PRINTER_USB_PID=0x0e15
#
#  Pour PRINTER_CONNECTION=network (Ethernet / Wi-Fi raw TCP/IP sur port 9100)
#  PRINTER_IP=192.168.1.100
#  PRINTER_PORT=9100
# ═══════════════════════════════════════════════════════════════

